{
	"name": "petstore",
	"version": "1.0.31",
	"description": "An example Express+Passport+TypeORM server based upon OpenAPI's petstore example specification.",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/composer-js/petstore_example.git"
	},
	"author": "RapidREST <rapidrests@gmail.com>",
	"license": "MIT",
	"contributors": [
		"Jean-Philippe Steinmetz"
	],
	"files": [
		"dist"
	],
	"scripts": {
		"build": "yarn lint && rimraf dist && tsc",
		"dbuild": "rimraf dist && tsc",
		"debug": "nodemon --legacy-watch --watch 'src/**/*' --ext 'ts' --exec 'tsx --inspect=0.0.0.0:9229 src/server.ts'",
		"docs": "typedoc --plugin typedoc-plugin-markdown --out docs/reference --target esnext --mode file src",
		"lint": "eslint ./src ./test",
		"local-audit": "yarn install && yarn npm audit -A -R \"$@\"",
		"checkup": "yarn dlx @yarnpkg/doctor \"$@\"",
		"dependency-check": "yarn dlx depcheck \"$@\"",
		"report-coverage": "cat ./coverage/lcov.info | coveralls",
		"profile:process": "node --prof-process --call-graph",
		"profile:view": "npx speedscope",
		"start": "tsx src/server.ts",
		"test": "vitest run --coverage",
		"test:prod": "yarn lint && yarn test",
		"test:watch": "vitest --coverage",
		"version": "node scripts/update_helm_version.js && git add helm/* README.md single_node_install.sh",
		"postversion": "git push --follow-tags"
	},
	"prettier": {
		"printWidth": 120,
		"semi": true,
		"singleQuote": false,
		"tabWidth": 4,
		"trailingComma": "es5"
	},
	"dependencies": {
		"@composer-js/service-core": "^8.0.4",
		"@types/node": "^25.9.3",
		"argon2": "^0.44.0",
		"cors": "^2.8.5",
		"express": "^4.21.2",
		"jsonwebtoken": "^9.0.2",
		"mongodb": "^6.12.0",
		"nconf": "^0.13.0",
		"passport": "^0.7.0",
		"passport-http": "^0.3.0",
		"passport-jwt": "^4.0.1",
		"prom-client": "^15.1.3",
		"reflect-metadata": "^0.2.2",
		"typeorm": "^0.3.20",
		"uuid": "^11.1.0",
		"winston": "^3.19.0",
		"winston-transport": "^4.9.0"
	},
	"devDependencies": {
		"@swc/core": "^1.15.41",
		"@types/cors": "^2.8.17",
		"@types/express": "^4.17.21",
		"@types/jsonwebtoken": "^9.0.9",
		"@types/nconf": "^0.10.7",
		"@types/passport": "^1.0.17",
		"@types/passport-http": "^0.3.9",
		"@types/passport-jwt": "^4.0.1",
		"@types/supertest": "^6.0.3",
		"@typescript-eslint/eslint-plugin": "^8.61.0",
		"@typescript-eslint/parser": "^8.61.0",
		"@vitest/coverage-v8": "^4.1.8",
		"coveralls": "^3.1.1",
		"eslint": "^10.5.0",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsdoc": "^63.0.2",
		"globals": "^17.6.0",
		"mongodb-memory-server": "^11.2.0",
		"nodemon": "^3.1.14",
		"rimraf": "^6.1.3",
		"supertest": "^7.0.0",
		"tsx": "^4.22.4",
		"typedoc": "^0.28.19",
		"typedoc-plugin-markdown": "^4.12.0",
		"typescript": "^6.0.3",
		"unplugin-swc": "^1.5.9",
		"vitest": "^4.1.8"
	},
	"resolutions": {
		"semver": "^7.5.2",
		"axios": "^1.17.0",
		"json-schema": "^0.4.0"
	},
	"packageManager": "yarn@4.2.2",
	"engines": {
		"node": ">=24.0.0"
	}
}
