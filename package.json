{
	"name": "petstore",
	"version": "1.0.8-cjs",
	"description": "An example RapidREST server based upon OpenAPI's petstore example specification.",
	"repository": {
		"type": "git",
		"url": "https://github.com/composer-js/petstore_example.git"
	},
	"author": "RapidREST <rapidrests@gmail.com>",
	"license": "MIT",
	"contributors": [
		"Jean-Philippe Steinmetz"
	],
	"files": [
		"dist"
	],
	"scripts": {
		"build": "yarn lint && yarn cibuild",
		"cibuild": "echo building && tsc",
		"debug": "nodemon --legacy-watch --watch 'src/**/*' --ext 'ts' --exec node --inspect=0.0.0.0:9229 --require ts-node/register ./src/server.ts",
		"docs": "typedoc --plugin typedoc-plugin-markdown --out docs/reference --target esnext --mode file src",
		"lint": "eslint ./src ./test",
		"local-audit": "yarn install && yarn npm audit -A -R \"$@\"",
		"checkup": "yarn dlx @yarnpkg/doctor \"$@\"",
		"dependency-check": "yarn dlx depcheck \"$@\"",
		"report-coverage": "cat ./coverage/lcov.info | coveralls",
		"start": "ts-node src/server.ts",
		"test": "jest --coverage --forceExit --runInBand",
		"test:prod": "npm run lint && npm run test -- --no-cache",
		"test:watch": "jest --coverage --watch",
		"version": "node scripts/update_helm_version.js && git add helm/*",
		"postversion": "git push --follow-tags"
	},
	"prettier": {
		"printWidth": 120,
		"semi": true,
		"singleQuote": false,
		"tabWidth": 4,
		"trailingComma": "es5"
	},
	"dependencies": {
		"@composer-js/core": "^6.0.0",
		"@composer-js/service-core": "^8.0.4",
		"@types/node": "^22.10.2",
		"argon2": "^0.44.0",
		"axios": "^1.7.9",
		"connect-redis": "^8.0.1",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.5",
		"express": "^5.2.1",
		"express-session": "^1.19.0",
		"ioredis": "^5.4.1",
		"lodash": "^4.17.21",
		"mongodb": "^6.12.0",
		"nconf": "^0.12.1",
		"openapi3-ts": "^4.4.0",
		"passport": "0.7.0",
		"passport-http": "^0.3.0",
		"passport-strategy": "1.0.0",
		"prom-client": "^15.1.3",
		"reflect-metadata": "^0.2.2",
		"typeorm": "^0.3.20",
		"winston": "^3.17.0",
		"winston-transport": "^4.9.0",
		"ws": "^8.18.0"
	},
	"devDependencies": {
		"@types/cookie-parser": "^1.4.8",
		"@types/express": "^5.0.6",
		"@types/ioredis-mock": "^8.2.5",
		"@types/jest": "^29.5.14",
		"@types/js-yaml": "^4.0.9",
		"@types/jsonwebtoken": "^9.0.7",
		"@types/k6": "^1.5.0",
		"@types/lodash": "^4.17.13",
		"@types/nconf": "^0.10.7",
		"@types/passport": "1.0.17",
		"@types/passport-http": "^0",
		"@types/passport-strategy": "0.2.38",
		"@typescript-eslint/eslint-plugin": "^8.18.1",
		"@typescript-eslint/parser": "^8.18.1",
		"coveralls": "^3.1.1",
		"eslint": "^9.17.0",
		"eslint-plugin-import": "^2.31.0",
		"eslint-plugin-jsdoc": "^50.6.1",
		"globals": "^15.14.0",
		"ioredis-mock": "^8.9.0",
		"jest": "^29.7.0",
		"jest-junit": "^16.0.0",
		"js-yaml": "^4.1.1",
		"mkdirp": "^3.0.1",
		"mongodb-memory-server": "^10.1.2",
		"nodemon": "^3.1.11",
		"rimraf": "^6.0.1",
		"supertest": "^7.0.0",
		"superwstest": "^2.0.4",
		"ts-jest": "^29.2.5",
		"ts-node": "^10.9.2",
		"typedoc": "^0.27.5",
		"typedoc-plugin-markdown": "^4.3.2",
		"typescript": "^5.7.2",
		"uuid": "^11.0.3"
	},
	"resolutions": {
		"semver": "^7.5.2",
		"axios": "^1.7.4",
		"json-schema": "^0.4.0"
	},
	"packageManager": "yarn@4.2.2",
	"engines": {
		"node": ">=20.0.0"
	}
}
