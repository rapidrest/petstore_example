{
    "compilerOptions": {
        "moduleResolution": "Bundler",
        "target": "ES2020",
        "module": "ESNext",
        "lib": ["ES2020"],
        "strict": false,
        "sourceMap": true,
        "allowSyntheticDefaultImports": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "outDir": "dist",
        "noImplicitAny": false,
        "typeRoots": ["node_modules/@types"],
        "types": ["vitest/globals"]
    },
    "include": ["src", "test"],
    "exclude": ["dist", "docs", "node_modules"]
}
